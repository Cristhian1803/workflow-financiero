# PostgreSQL (docker compose)
POSTGRES_DB=workflow_financiero
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_PORT=5432

# Spring (mapeo para la aplicacion)
DB_URL=jdbc:postgresql://localhost:5432/workflow_financiero
DB_USER=workflow
DB_PASSWORD=workflow

# JWT: obligatorio en desarrollo y produccion. No se versiona un secreto real.
# Generar uno con PowerShell:
#   $bytes = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRETO=
JWT_EMISOR=workflow-financiero
JWT_EXPIRACION_MINUTOS=60

# Clave de los usuarios demo. Solo se usa en perfiles desarrollo y pruebas.
DEMO_CLAVE=demo
