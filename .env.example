# PostgreSQL (docker compose)
POSTGRES_DB=workflow_financiero
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_PORT=5432

# Spring (mapeo para la aplicacion)
DB_URL=jdbc:postgresql://localhost:5432/workflow_financiero
DB_USER=workflow
DB_PASSWORD=workflow

# JWT: obligatorio en desarrollo y produccion. No se versiona un secreto real.
# Generar uno con PowerShell:
#   $bytes = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRETO=
JWT_EMISOR=workflow-financiero
JWT_EXPIRACION_MINUTOS=60

# Clave de los usuarios demo. Solo se usa en perfiles desarrollo y pruebas.
DEMO_CLAVE=demo

# Proveedor financiero simulado.
# El secreto debe tener un valor no vacio para que el simulador acepte las
# llamadas del trabajador de ejecucion. La URL apunta al mismo proceso.
PROVEEDOR_FINANCIERO_URL=http://localhost:8080/api/v1/integraciones/proveedor-financiero
PROVEEDOR_FINANCIERO_TIEMPO_CONEXION=PT2S
PROVEEDOR_FINANCIERO_TIEMPO_LECTURA=PT5S
PROVEEDOR_FINANCIERO_SECRETO=

# Riesgo externo simulado.
# El secreto firma las notificaciones HMAC. Si queda vacio, el endpoint
# rechaza todas las notificaciones con 401.
RIESGO_EXTERNO_PROVEEDOR=proveedor-riesgo-simulado
RIESGO_EXTERNO_SECRETO=
RIESGO_EXTERNO_VENTANA_TIEMPO=PT5M
RIESGO_EXTERNO_VENCIMIENTO=PT24H
RIESGO_EXTERNO_REINTENTO=PT5S
RIESGO_EXTERNO_MAXIMO_INTENTOS=3

# Plazos de aprobacion. Los valores por defecto son los de produccion.
APROBACION_DURACION_NOTIFICACION=PT24H
APROBACION_DURACION_REASIGNACION=PT48H

# Trabajador de ejecucion. En desarrollo se habilita desde el perfil; estas
# variables permiten ajustar el intervalo y los reintentos.
EJECUCION_TRABAJADOR_HABILITADO=false
EJECUCION_TRABAJADOR_INTERVALO_MS=2000
EJECUCION_TRABAJADOR_MAX_INTENTOS=3
EJECUCION_TRABAJADOR_RECLAMACION_VENCIDA=PT30S
EJECUCION_TRABAJADOR_REINTENTO_ESPERA=PT5S
