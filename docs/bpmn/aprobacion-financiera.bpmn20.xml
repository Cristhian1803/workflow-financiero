<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://workflow.financiero/proceso/aprobacion-financiera">

    <message id="mensajeRiesgoEvaluado" name="RIESGO_EVALUADO"/>

    <process id="aprobacionFinanciera" name="Aprobación financiera" isExecutable="true">
        <documentation>
            Orquesta la verificación, las aprobaciones y la preparación controlada de una
            solicitud financiera. El plan de aprobación se calcula en la aplicación; el
            proceso solo verifica sus banderas y registra el avance.
        </documentation>

        <startEvent id="inicioSolicitud" name="Inicio de la solicitud"/>

        <serviceTask id="verificarSolicitud" name="Verificar información"
                     flowable:delegateExpression="${delegadoVerificarSolicitud}">
            <documentation>
                Comprueba que la solicitud y la revisión existan y que sus datos
                obligatorios estén persistidos.
            </documentation>
        </serviceTask>

        <serviceTask id="verificarRiesgo" name="Verificar nivel de riesgo"
                     flowable:delegateExpression="${delegadoVerificarRiesgo}">
            <documentation>
                Comprueba que la revisión ya tenga un nivel de riesgo clasificado.
            </documentation>
        </serviceTask>

        <serviceTask id="verificarPlan" name="Verificar plan de aprobación"
                     flowable:delegateExpression="${delegadoVerificarPlan}">
            <documentation>
                Comprueba que el plan recibido coincida con el calculado por la aplicación.
            </documentation>
        </serviceTask>

        <exclusiveGateway id="decidirAprobaciones" name="¿Requiere aprobaciones?"
                          default="flujoSinAprobacion"/>

        <serviceTask id="marcarPendienteAprobacion" name="Marcar pendiente de aprobación"
                     flowable:delegateExpression="${delegadoMarcarPendienteAprobacion}">
            <documentation>
                Deja la revisión en PENDIENTE_APROBACION antes de abrir las tareas humanas.
            </documentation>
        </serviceTask>

        <inclusiveGateway id="ramasAprobacion" name="Ramas de aprobación"/>

        <userTask id="tareaSupervisor" name="Aprobación de Supervisor"
                  flowable:candidateGroups="SUPERVISOR">
            <documentation>
                Aprobación funcional del rol Supervisor. El actor debe ser distinto del
                solicitante y no puede acumular otro rol funcional en la misma solicitud.
            </documentation>
        </userTask>

        <userTask id="tareaGerente" name="Aprobación de Gerente"
                  flowable:candidateGroups="GERENTE">
            <documentation>
                Aprobación funcional del rol Gerente. Puede delegarse en Gerente General
                según la configuración de superiores.
            </documentation>
        </userTask>

        <userTask id="tareaRiesgos" name="Aprobación de Riesgos"
                  flowable:candidateGroups="RIESGOS">
            <documentation>
                Aprobación funcional del rol Riesgos. Puede delegarse en Jefe de Riesgos
                según la configuración de superiores.
            </documentation>
        </userTask>

        <exclusiveGateway id="decidirSupervisor" name="Decisión de Supervisor"/>
        <exclusiveGateway id="decidirGerente" name="Decisión de Gerente"/>
        <exclusiveGateway id="decidirRiesgos" name="Decisión de Riesgos"/>

        <inclusiveGateway id="unionAprobaciones" name="Unión de aprobaciones"/>

        <serviceTask id="verificarAutorizacion" name="Verificar autorización"
                     flowable:delegateExpression="${delegadoVerificarAutorizacion}">
            <documentation>
                Vuelve a comprobar el plan, las decisiones persistidas y la segregación de
                funciones antes de preparar cualquier ejecución.
            </documentation>
        </serviceTask>

        <exclusiveGateway id="decidirRiesgoExterno" name="¿Requiere riesgo externo?"
                          default="flujoSinRiesgoExterno"/>

        <intermediateCatchEvent id="esperarRiesgoExterno" name="Esperar riesgo externo">
            <messageEventDefinition messageRef="mensajeRiesgoEvaluado"/>
        </intermediateCatchEvent>

        <serviceTask id="verificarRiesgoExterno" name="Verificar riesgo externo"
                     flowable:delegateExpression="${delegadoVerificarRiesgoExterno}">
            <documentation>
                Valida el resultado externo recibido antes de permitir el avance. En esta
                etapa se usa un fixture controlado.
            </documentation>
        </serviceTask>

        <serviceTask id="marcarAprobada" name="Marcar aprobada"
                     flowable:delegateExpression="${delegadoMarcarAprobada}">
            <documentation>
                Transiciona la revisión a APROBADA. La ejecución financiera real no se
                confirma en este proceso.
            </documentation>
        </serviceTask>

        <serviceTask id="prepararEjecucion" name="Preparar ejecución controlada"
                     flowable:delegateExpression="${delegadoPrepararEjecucion}">
            <documentation>
                Registra la preparación de la ejecución mediante un adaptador controlado,
                sin llamar a un proveedor financiero.
            </documentation>
        </serviceTask>

        <serviceTask id="registrarResultado" name="Registrar resultado controlado"
                     flowable:delegateExpression="${delegadoRegistrarResultado}">
            <documentation>
                Registra el resultado simulado y finaliza el proceso.
            </documentation>
        </serviceTask>

        <endEvent id="finProceso" name="Fin del proceso"/>

        <serviceTask id="registrarRechazo" name="Registrar rechazo"
                     flowable:delegateExpression="${delegadoRegistrarRechazo}">
            <documentation>
                Cancela las tareas pendientes de la revisión y la deja en RECHAZADA.
            </documentation>
        </serviceTask>

        <endEvent id="finRechazo" name="Fin por rechazo">
            <terminateEventDefinition flowable:terminateAll="true"/>
        </endEvent>

        <boundaryEvent id="notificarSupervisor24h" attachedToRef="tareaSupervisor"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionNotificacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <boundaryEvent id="reasignarSupervisor48h" attachedToRef="tareaSupervisor"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionReasignacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <serviceTask id="notificarSupervisor" name="Notificar escalamiento de Supervisor"
                     flowable:delegateExpression="${delegadoNotificarEscalamiento}"/>

        <serviceTask id="reasignarSupervisor" name="Reasignar tarea de Supervisor"
                     flowable:delegateExpression="${delegadoReasignarTarea}"/>

        <endEvent id="finNotificacionSupervisor" name="Fin de notificación"/>
        <endEvent id="finReasignacionSupervisor" name="Fin de reasignación"/>

        <boundaryEvent id="notificarGerente24h" attachedToRef="tareaGerente"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionNotificacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <boundaryEvent id="reasignarGerente48h" attachedToRef="tareaGerente"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionReasignacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <serviceTask id="notificarGerente" name="Notificar escalamiento de Gerente"
                     flowable:delegateExpression="${delegadoNotificarEscalamiento}"/>

        <serviceTask id="reasignarGerente" name="Reasignar tarea de Gerente"
                     flowable:delegateExpression="${delegadoReasignarTarea}"/>

        <endEvent id="finNotificacionGerente" name="Fin de notificación"/>
        <endEvent id="finReasignacionGerente" name="Fin de reasignación"/>

        <boundaryEvent id="notificarRiesgos24h" attachedToRef="tareaRiesgos"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionNotificacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <boundaryEvent id="reasignarRiesgos48h" attachedToRef="tareaRiesgos"
                       cancelActivity="false">
            <timerEventDefinition>
                <timeDuration xsi:type="tFormalExpression">${duracionReasignacion}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <serviceTask id="notificarRiesgos" name="Notificar escalamiento de Riesgos"
                     flowable:delegateExpression="${delegadoNotificarEscalamiento}"/>

        <serviceTask id="reasignarRiesgos" name="Reasignar tarea de Riesgos"
                     flowable:delegateExpression="${delegadoReasignarTarea}"/>

        <endEvent id="finNotificacionRiesgos" name="Fin de notificación"/>
        <endEvent id="finReasignacionRiesgos" name="Fin de reasignación"/>

        <sequenceFlow id="flujoInicio" sourceRef="inicioSolicitud" targetRef="verificarSolicitud"/>
        <sequenceFlow id="flujoVerificarSolicitud" sourceRef="verificarSolicitud" targetRef="verificarRiesgo"/>
        <sequenceFlow id="flujoVerificarRiesgo" sourceRef="verificarRiesgo" targetRef="verificarPlan"/>
        <sequenceFlow id="flujoVerificarPlan" sourceRef="verificarPlan" targetRef="decidirAprobaciones"/>

        <sequenceFlow id="flujoRequiereAprobacion" sourceRef="decidirAprobaciones"
                      targetRef="marcarPendienteAprobacion">
            <conditionExpression xsi:type="tFormalExpression">${requiereAprobacion == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoSinAprobacion" sourceRef="decidirAprobaciones"
                      targetRef="verificarAutorizacion"/>

        <sequenceFlow id="flujoPendienteAprobacion" sourceRef="marcarPendienteAprobacion"
                      targetRef="ramasAprobacion"/>

        <sequenceFlow id="flujoSupervisor" sourceRef="ramasAprobacion" targetRef="tareaSupervisor">
            <conditionExpression xsi:type="tFormalExpression">${requiereSupervisor == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoGerente" sourceRef="ramasAprobacion" targetRef="tareaGerente">
            <conditionExpression xsi:type="tFormalExpression">${requiereGerente == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoRiesgos" sourceRef="ramasAprobacion" targetRef="tareaRiesgos">
            <conditionExpression xsi:type="tFormalExpression">${requiereRiesgos == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoSupervisorDecision" sourceRef="tareaSupervisor" targetRef="decidirSupervisor"/>
        <sequenceFlow id="flujoGerenteDecision" sourceRef="tareaGerente" targetRef="decidirGerente"/>
        <sequenceFlow id="flujoRiesgosDecision" sourceRef="tareaRiesgos" targetRef="decidirRiesgos"/>

        <sequenceFlow id="flujoSupervisorAprobado" sourceRef="decidirSupervisor"
                      targetRef="unionAprobaciones">
            <conditionExpression xsi:type="tFormalExpression">${decisionSupervisor == 'APROBADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoSupervisorRechazado" sourceRef="decidirSupervisor"
                      targetRef="registrarRechazo">
            <conditionExpression xsi:type="tFormalExpression">${decisionSupervisor == 'RECHAZADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoGerenteAprobado" sourceRef="decidirGerente"
                      targetRef="unionAprobaciones">
            <conditionExpression xsi:type="tFormalExpression">${decisionGerente == 'APROBADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoGerenteRechazado" sourceRef="decidirGerente"
                      targetRef="registrarRechazo">
            <conditionExpression xsi:type="tFormalExpression">${decisionGerente == 'RECHAZADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoRiesgosAprobado" sourceRef="decidirRiesgos"
                      targetRef="unionAprobaciones">
            <conditionExpression xsi:type="tFormalExpression">${decisionRiesgos == 'APROBADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoRiesgosRechazado" sourceRef="decidirRiesgos"
                      targetRef="registrarRechazo">
            <conditionExpression xsi:type="tFormalExpression">${decisionRiesgos == 'RECHAZADA'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoUnionAprobaciones" sourceRef="unionAprobaciones"
                      targetRef="verificarAutorizacion"/>

        <sequenceFlow id="flujoVerificarAutorizacion" sourceRef="verificarAutorizacion"
                      targetRef="decidirRiesgoExterno"/>

        <sequenceFlow id="flujoRequiereRiesgoExterno" sourceRef="decidirRiesgoExterno"
                      targetRef="esperarRiesgoExterno">
            <conditionExpression xsi:type="tFormalExpression">${requiereEvaluacionExterna == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flujoSinRiesgoExterno" sourceRef="decidirRiesgoExterno"
                      targetRef="marcarAprobada"/>

        <sequenceFlow id="flujoEsperaRiesgoExterno" sourceRef="esperarRiesgoExterno"
                      targetRef="verificarRiesgoExterno"/>

        <sequenceFlow id="flujoVerificarRiesgoExterno" sourceRef="verificarRiesgoExterno"
                      targetRef="marcarAprobada"/>

        <sequenceFlow id="flujoMarcarAprobada" sourceRef="marcarAprobada"
                      targetRef="prepararEjecucion"/>

        <sequenceFlow id="flujoPrepararEjecucion" sourceRef="prepararEjecucion"
                      targetRef="registrarResultado"/>

        <sequenceFlow id="flujoRegistrarResultado" sourceRef="registrarResultado"
                      targetRef="finProceso"/>

        <sequenceFlow id="flujoRechazo" sourceRef="registrarRechazo" targetRef="finRechazo"/>

        <sequenceFlow id="flujoNotificarSupervisor24h" sourceRef="notificarSupervisor24h"
                      targetRef="notificarSupervisor"/>
        <sequenceFlow id="flujoFinNotificacionSupervisor" sourceRef="notificarSupervisor"
                      targetRef="finNotificacionSupervisor"/>
        <sequenceFlow id="flujoReasignarSupervisor48h" sourceRef="reasignarSupervisor48h"
                      targetRef="reasignarSupervisor"/>
        <sequenceFlow id="flujoFinReasignacionSupervisor" sourceRef="reasignarSupervisor"
                      targetRef="finReasignacionSupervisor"/>

        <sequenceFlow id="flujoNotificarGerente24h" sourceRef="notificarGerente24h"
                      targetRef="notificarGerente"/>
        <sequenceFlow id="flujoFinNotificacionGerente" sourceRef="notificarGerente"
                      targetRef="finNotificacionGerente"/>
        <sequenceFlow id="flujoReasignarGerente48h" sourceRef="reasignarGerente48h"
                      targetRef="reasignarGerente"/>
        <sequenceFlow id="flujoFinReasignacionGerente" sourceRef="reasignarGerente"
                      targetRef="finReasignacionGerente"/>

        <sequenceFlow id="flujoNotificarRiesgos24h" sourceRef="notificarRiesgos24h"
                      targetRef="notificarRiesgos"/>
        <sequenceFlow id="flujoFinNotificacionRiesgos" sourceRef="notificarRiesgos"
                      targetRef="finNotificacionRiesgos"/>
        <sequenceFlow id="flujoReasignarRiesgos48h" sourceRef="reasignarRiesgos48h"
                      targetRef="reasignarRiesgos"/>
        <sequenceFlow id="flujoFinReasignacionRiesgos" sourceRef="reasignarRiesgos"
                      targetRef="finReasignacionRiesgos"/>
    </process>

